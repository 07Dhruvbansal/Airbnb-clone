<% layout("/layouts/boilerplate") %>

<h1>All Listings</h1>

<a href="/listings/new">
    <button type="button">Create a new place</button>
</a>

<ul>
    <% for (let listing of allListings) { %>
        <li>
            <a href="/listings/<%= listing._id %>">
                <%= listing.title %>
            </a>
        </li>
    <% } %>
</ul>