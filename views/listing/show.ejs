<% layout("/layouts/boilerplate") %>

<body>

    <h1>
        <%= listing.title %>
    </h1>

    <p>
        <%= listing.description %>
    </p>

    <p>Price: ₹<%= listing.price %>
    </p>

    <p>Location: <%= listing.location %>
    </p>

    <p>Country: <%= listing.country %>
    </p>

    <img src="<%= listing.image.url %>" alt="<%= listing.title %>" width="400">

    <a href="/listings/<%= listing._id %>/edit">
        <button>Edit this listing</button>
    </a>

    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
        <button type="submit">Delete this listing</button>
    </form>

</body>

</html>
